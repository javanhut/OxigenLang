introduce os
introduce regex
introduce strings
introduce toml

unsuccessful_system_call <Error> = <Error<unsuccessful_system_call>>("system code not 0")
oxigen_repo_url <str> = "https://github.com/javanhut/OxigenLang.git"

fun check_os() {
    system <str> = os.name()
    arch <str> = os.arch()
    println("System: {system}, Architecture: {arch}")
    op_sys <str> := option {
        system == "macos" -> {
            "darwin"
        }
        system == "linux" -> {
            "linux"
        }
        system == "windows" -> {
            "windows"
        }
        {
            "unknown"
        }
    }
    println("Operating system is known: {strings.upper(op_sys)}") unless op_sys == "unknown"
    (system, arch, op_sys)
}

fun check_installation(package <str>) {
    run_command <str> := "which {package}"
    results <map> := os.exec(run_command)
    out := results["stdout"]
    code := results["code"]
    success := option {
        code != 0 -> {
            println("[Error] system code: {code}")
            <fail>(unsuccessful_system_call)
        }
        {
            True
        }
    }
    println("{strings.upper(package)} is installed at: {out}") unless not success then println("{strings.upper(package)} is not installed")
    True
}

fun check_oxigen_version() {
    run_command <str> := "oxigen --version"
    results <map> := os.exec(run_command)
    out := results["stdout"]
    code := results["code"]
    success := option {
        code != 0 -> {
            println("[Error] system code: {code}")
            <fail>(unsuccessful_system_call)
        }
        {
            True
        }
    }
    (True, version_from_output(out)) unless not success then (False, "")
}

// `oxigen --version` prints "Oxigen Version: 0.1.4": the version is the last word.
fun version_from_output(out <str>) {
    words := strings.split(strings.trim(out), " ")
    words[len(words) - 1]
}

fun semantic_version_split(version_str <str>) {
    major, minor, patch := strings.split(version_str, ".")
    (int(major), int(minor), int(patch))
}

// Whether version `a` comes after version `b`.
fun is_newer(a <str>, b <str>) {
    a_major, a_minor, a_patch := semantic_version_split(a)
    b_major, b_minor, b_patch := semantic_version_split(b)
    option {
        a_major != b_major -> {
            a_major > b_major
        }
        a_minor != b_minor -> {
            a_minor > b_minor
        }
        {
            a_patch > b_patch
        }
    }
}

// The newest release version (the X.Y.Z of a vX.Y.Z tag) in the output of
// `git ls-remote --tags --refs`, or "" when there is none. Updating builds a
// release tag, never whatever the default branch holds at the moment.
fun latest_release(listing <str>) {
    best := ""
    each line in strings.split(listing, "\n") {
        found := regex.captures("refs/tags/v(\\d+)\\.(\\d+)\\.(\\d+)$", strings.trim(line))
        option {
            found != None -> {
                version := "{found[1]}.{found[2]}.{found[3]}"
                option {
                    best == "" or is_newer(version, best) -> {
                        best = version
                    }
                }
            }
        }
    }
    best
}

fun cleanup_tmp_dir(home_dir <str>, total_path <str>) {
    os.chdir(home_dir)
    option {
        os.is_dir(total_path) -> {
            os.rmdir(total_path)
            <log<cleanup>>("Removed temp dir: {total_path}") unless os.is_dir(total_path) == True then <fail>("Failed to remove temp directory")
        }
    }
}

fun update_oxigen(home_dir <str>, total_path <str>) {
    // install.sh builds first and stops before touching the installed copy
    // if the build fails, so a broken build leaves the current oxigen in place.
    install_command <str> = "./scripts/install.sh"
    <log<install>>("Building and installing updated version....")
    install := os.exec(install_command)
    i_out, i_err, i_code := (install["stdout"], install["stderr"], install["code"])
    option {
        i_code != 0 -> {
            <log>(i_err) unless strings.trim(i_err) == ""
            cleanup_tmp_dir(home_dir, total_path)
            <log<Error>>("Failed to build or install with code: {i_code}")
            <fail>(unsuccessful_system_call)
        }
        {
            <log<debug>>(i_out)
        }
    }
    cleanup_tmp_dir(home_dir, total_path)
    <log<finished>>("Update has finished. Refresh your shell or reopen the terminal for the updated version.")
}

fun log_regression_and_cleanup(home_dir <str>, total_path <str>) {
    <log<Regression>>("The installed version seems to be ahead of the repo version.\nYou might have pulled from an experimental branch. Nothing to update...")
    cleanup_tmp_dir(home_dir, total_path)
}

fun log_no_update_and_cleanup(home_dir <str>, total_path <str>) {
    <log<debug>>("Nothing to update.")
    cleanup_tmp_dir(home_dir, total_path)
}

main {
    sys, arch, op_sys := check_os()
    is_rust_installed := check_installation(package="rustc")
    is_git_installed := check_installation(package="git")
    is_oxigen_installed := check_installation(package="oxigen")
    installed_oxigen_ver <str>
    option {
        is_rust_installed and is_git_installed -> {
            println("All dependencies are installed")
        }
        {
            println("Missing dependencies:")
            println("Missing Git") unless not is_git_installed
            println("Missing Rust") unless not is_rust_installed
            <fail>("Missing dependencies")
        }
    }
    home_dir <str>
    option {
        is_oxigen_installed -> {
            println("Oxigen is installed! Checking version number....")
            has_version, ver := check_oxigen_version()
            option {
                has_version == False -> {
                    println("Oxigen is either out of date or missing from system binaries. Install Oxigen to update.")
                }
                {
                    println("Version Check: {ver}")
                    installed_oxigen_ver := strings.trim(ver)
                    println("Downloading oxigen into temp dir....")
                    maybe_home := os.env_get("HOME")
                    home_dir = option {
                        maybe_home == None -> {
                            <fail>("HOME is not set")
                        }
                        {
                            maybe_home
                        }
                    }
                }
            }
        }
    }
    path_to_home <str> := home_dir + "/"
    tmp_dir_path <str> := ".oxigen_tmp"
    total_path := path_to_home + tmp_dir_path
    <log<debug>>("Making dir: {total_path}")
    option {
        os.is_dir(total_path) -> {
            println("Directory exists. Removing...")
            os.rmdir(total_path)
            <log>("Successfully removed: {total_path}") unless os.is_dir(total_path) == True then <fail>("Failed to remove directory")
        }
    }
    os.mkdir(total_path)
    option {
        os.is_dir(total_path) -> {
            <log>("Successfully created tmp path at: {total_path}")
        }
        {
            <fail>("Failed to create new directory.")
        }
    }
    os.chdir(total_path)
    tags := os.exec("git ls-remote --tags --refs {oxigen_repo_url}")
    option {
        tags["code"] != 0 -> {
            <log>(tags["stderr"]) unless strings.trim(tags["stderr"]) == ""
            cleanup_tmp_dir(home_dir, total_path)
            <fail>("Failed to list releases {tags["code"]}")
        }
    }
    release <str> := latest_release(tags["stdout"])
    option {
        release == "" -> {
            cleanup_tmp_dir(home_dir, total_path)
            <fail>("No release tags found at {oxigen_repo_url}")
        }
    }
    <log>("Latest release: v{release}")
    results := os.exec("git clone --depth 1 --branch v{release} {oxigen_repo_url}")
    out, err, code := (results["stdout"], results["stderr"], results["code"])
    option {
        code != 0 -> {
            <log>(err) unless strings.trim(err) == ""
            cleanup_tmp_dir(home_dir, total_path)
            <fail>("Failed to run command {code}")
        }
        {
            <log<debug>>(out) unless strings.trim(out) == ""
        }
    }
    os.chdir("OxigenLang")
    cargo_info := toml.read("crates/oxigen-cli/Cargo.toml")
    package_ver <str> := strings.trim(cargo_info["package"]["version"])
    option {
        package_ver == installed_oxigen_ver -> {
            same_version_error <Error> = <Error<same_version_error>>("Oxigen version is same as installed version.\nIf you think oxigen has been updated do a git pull of latest repo and a clean install.")
            <log<Error<same_version_error>>>
            cleanup_tmp_dir(home_dir, total_path)
            os.exit(1)
        }
        {
            <log>("Versions differ. Checking if version is newer.")
            new_pull := semantic_version_split(package_ver)
            installed_version := semantic_version_split(installed_oxigen_ver)
            p_major, p_minor, p_patch := new_pull
            i_major, i_minor, i_patch := installed_version
            option {
                p_major > i_major -> {
                    <log<update>>("Update is available. Version: v{package_ver}. Installing new Oxigen version...")
                    update_oxigen(home_dir, total_path)
                }
                p_major == i_major -> {
                    option {
                        p_minor > i_minor -> {
                            <log<update>>("Update is available. Version: v{package_ver}. Installing new Oxigen version...")
                            update_oxigen(home_dir, total_path)
                        }
                        p_minor == i_minor -> {
                            option {
                                p_patch > i_patch -> {
                                    <log<update>>("Update is available. Version: v{package_ver}. Installing new Oxigen version...")
                                    update_oxigen(home_dir, total_path)
                                }
                                p_patch == i_patch -> {
                                    log_no_update_and_cleanup(home_dir, total_path)
                                }
                                {
                                    log_regression_and_cleanup(home_dir, total_path)
                                }
                            }
                        }
                        {
                            log_regression_and_cleanup(home_dir, total_path)
                        }
                    }
                }
                {
                    log_regression_and_cleanup(home_dir, total_path)
                }
            }
        }
    }
}

<test>("version_from_output takes the version, not the label") {
    expect(version_from_output("Oxigen Version: 0.1.4\n")).eq("0.1.4")
}

<test>("latest_release picks the highest vX.Y.Z tag") {
    listing := "a1\trefs/tags/v0.1.4\nb2\trefs/tags/v0.10.0\nc3\trefs/tags/v0.9.9\nd4\trefs/tags/v1.0.0-rc1\n"
    expect(latest_release(listing)).eq("0.10.0")
}

<test>("latest_release is empty without release tags") {
    expect(latest_release("a1\trefs/tags/nightly\n")).eq("")
}

<test>("is_newer compares numerically") {
    expect(is_newer("0.10.0", "0.9.9")).eq(True)
    expect(is_newer("0.1.4", "0.1.4")).eq(False)
    expect(is_newer("1.0.0", "0.99.99")).eq(True)
}
