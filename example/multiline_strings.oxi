name := "Raven"
version := 1
message := """
Welcome, {name}!
You are running Oxigen v{version}.
"""
println(message)
banner := """+--------------------+
|  Oxigen multiline  |
+--------------------+"""
println(banner)
quote := """She said "multi-line strings are great" and meant it."""
println(quote)
x := 10
y := 20
sum := """{x + y}"""
println("sum = {sum}")
escaped := """tab\there
and a literal quote: " done"""
println(escaped)
