introduce net
introduce json
introduce strings

main {
    payload := json.stringify({"model": "llama3", "prompt": "Say hello in five words."})
    s := net.stream_post("http://localhost:11434/api/generate", payload)
    text <str> := ""
    done := False
    repeat unless done {
        line := strings.trim(net.read_line(s))
        option {
            line == "" -> {
                done = True
            }
            {
                obj := json.parse(line)
                text = text + obj["response"]
                print(obj["response"])
                done = obj["done"]
            }
        }
    }
    net.close(s)
    println("")
    println("--- captured {len(text)} chars ---")
}
