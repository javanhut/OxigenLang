// Threads
// diverge runs tasks on threads, one Web Worker each; a channel passes messages between them.
introduce channel

fun is_prime(n <int>) {
    give False when n < 2
    d := 2
    repeat when d * d <= n {
        give False when n % d == 0
        d++
    }
    True
}

fun count_primes(lo <int>, hi <int>) {
    count := 0
    each n in range(lo, hi) {
        count++ when is_prime(n)
    }
    count
}

main {
    // Four tasks at once; the results come back in order.
    counts := diverge each start in [0, 25000, 50000, 75000] {
        count_primes(start, start + 25000)
    }
    println("primes below 100000, by quarter: {counts}")

    // A worker that takes jobs off a channel until it is closed.
    jobs := channel.new()
    worker := diverge {
        done := 0
        repeat when True {
            job := channel.recv(jobs)
            stop when job == None
            println("worker got: {job}")
            done++
        }
        done
    }
    each word in ["one", "two", "three"] {
        channel.send(jobs, word)
    }
    channel.close(jobs)
    println("the worker handled {converge worker} jobs")
}
