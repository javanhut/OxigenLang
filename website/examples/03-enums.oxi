// Enums and pattern matching
// Rust-style enums with payloads, and named patterns matched with `choose`.
introduce math

enum Shape {
    Circle(radius <float>)
    Rect { w <float>, h <float> }
    Dot
}

fun area(shape <Shape>) {
    option {
        shape.name == "Circle" -> {
            math.round(math.PI * shape.radius * shape.radius)
        }
        shape.name == "Rect" -> {
            shape.w * shape.h
        }
        {
            0.0
        }
    }
}

pattern is_large(a) when a > 50

pattern is_empty(a) when a == 0

main {
    shapes := [Shape.Circle(3.0), Shape.Rect { w: 4.0, h: 15.0 }, Shape.Dot]
    each s in shapes {
        a := area(s)
        choose a {
            is_large -> println("{s.name}: large, area {a}")
            is_empty -> println("{s.name}: no area")
            else -> println("{s.name}: small, area {a}")
        }
    }
}
