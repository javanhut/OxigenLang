// Errors as values
// Errors propagate by default; <Error>, <guard> and the result module make failure explicit.
introduce result

fun parse_port(text <str>) {
    option {
        text == "" -> <Error<config>>("port is empty"),
        int(text)
    }
}

fun describe(raw <str>) {
    port := parse_port(raw)
    option {
        is_error(port) -> "[{port.tag}] {port.msg}, falling back to 8080",
        "listening on port {port}"
    }
}

main {
    println(describe("3000"))
    println(describe(""))

    // result.unwrap_or turns an error value into a default.
    println("port:", result.unwrap_or(parse_port(""), 8080))

    // <guard> recovers from a runtime error, such as an index out of range.
    items := [1, 2, 3]
    println("items[10] guarded:", items[10] <guard>(-1))
}
