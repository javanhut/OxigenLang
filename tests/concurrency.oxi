introduce {expect} from test

fun sq(x) { x * x }

fun scaled_by(factor) {
    diverge each x in [1, 2, 3] {
        x * factor
    }
}

main {
    t := diverge {
        sq(6)
    }
    expect(converge t).eq(36)
    u := diverge {
        sq(6)
    }
    expect(u * 2).eq(72)
    expect(diverge each n in [1, 2, 3, 4] {
        sq(n)
    }).eq([1, 4, 9, 16])
    expect(converge [diverge {
        sq(3)
    }, diverge {
        sq(4)
    }]).eq([9, 16])
    expect(scaled_by(10)).eq([10, 20, 30])
    println("concurrency ok")
}
