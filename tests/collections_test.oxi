// The builtins that change arrays, maps and sets in place: push, insert,
// remove, pop, extend, clear, plus has, copy and set(array).
<test>("push adds to arrays and sets") {
    a := [1]
    push(a, 2)
    expect(a).eq([1, 2])
    s := set(1)
    push(s, 2)
    push(s, 2)
    expect(s).eq(set(1, 2))
    expect(<type<Error> || <Value>>(push(s, [3]))).is_error()
}

<test>("insert into a map, a set, or an array at an index") {
    m := {"a": 1}
    insert(m, "b", 2)
    expect(m).eq({"a": 1, "b": 2})
    s := set(1)
    insert(s, 2)
    expect(s).eq(set(1, 2))
    a := [1, 3]
    insert(a, 1, 2)
    insert(a, 0, 0)
    insert(a, len(a), 4)
    insert(a, -1, 9)
    expect(a).eq([0, 1, 2, 3, 9, 4])
    expect(<type<Error> || <Value>>(insert(a, 99, 0))).is_error()
    expect(<type<Error> || <Value>>(insert(s, 3, None))).is_error()
}

<test>("remove by key or value") {
    m := {"a": 1, "b": 2}
    remove(m, "a")
    remove(m, "missing")
    expect(m).eq({"b": 2})
    s := set(1, 2, 3)
    remove(s, 2)
    expect(s).eq(set(1, 3))
    a := [1, 2, 3, 2]
    remove(a, 2)
    expect(a).eq([1, 3, 2])
    remove(a, 99)
    expect(a).eq([1, 3, 2])
}

<test>("pop returns what it removes") {
    a := [1, 2, 3, 4]
    expect(pop(a)).eq(4)
    expect(pop(a, 0)).eq(1)
    expect(pop(a, -1)).eq(3)
    expect(a).eq([2])
    m := {"a": 1}
    expect(pop(m, "a")).eq(1)
    expect(pop(m, "a")).eq(None)
    expect(len(m)).eq(0)
    s := set(1, 2)
    expect(pop(s)).eq(2)
    expect(s).eq(set(1))
    expect(<type<Error> || <Value>>(pop([]))).is_error()
    expect(<type<Error> || <Value>>(pop(set()))).is_error()
    expect(<type<Error> || <Value>>(pop([1], 5))).is_error()
}

<test>("extend adds many at once") {
    a := [1]
    extend(a, [2, 3])
    extend(a, (4, 5))
    expect(a).eq([1, 2, 3, 4, 5])
    s := set(1)
    extend(s, [1, 2, 2, 3])
    expect(s).eq(set(1, 2, 3))
    m := {"a": 1, "b": 2}
    extend(m, {"b": 20, "c": 3})
    expect(m).eq({"a": 1, "b": 20, "c": 3})
}

<test>("clear empties in place") {
    a := [1, 2]
    alias := a
    clear(a)
    expect(len(alias)).eq(0)
    m := {"a": 1}
    clear(m)
    expect(len(m)).eq(0)
    s := set(1)
    clear(s)
    expect(len(s)).eq(0)
}

<test>("copy is a separate collection") {
    a := [1, 2]
    b := copy(a)
    push(b, 3)
    expect(a).eq([1, 2])
    expect(b).eq([1, 2, 3])
    s := set(1)
    t := copy(s)
    push(t, 2)
    expect(len(s)).eq(1)
    m := {"a": 1}
    n := copy(m)
    insert(n, "b", 2)
    expect(len(m)).eq(1)
}

<test>("has searches every collection and strings") {
    expect(has([1, 2], 2)).truthy()
    expect(has((1, 2), 3)).falsy()
    expect(has({"a": 1}, "a")).truthy()
    expect(has(set(1), 1)).truthy()
    expect(has("hello", "ell")).truthy()
    expect(has("hello", `z`)).falsy()
}

<test>("set(array) takes the array's elements") {
    expect(set([1, 2, 2, 3])).eq(set(1, 2, 3))
    expect(len(set([]))).eq(0)
}
