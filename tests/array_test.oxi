introduce array

<test>("folds: sum and product") {
    expect(array.sum([1, 2, 3, 4])).eq(10)
    expect(array.product([1, 2, 3, 4])).eq(24)
    expect(array.sum([])).eq(0)
    expect(array.product([])).eq(1)
}

<test>("min and max") {
    expect(array.min([3, 1, 2])).eq(1)
    expect(array.max([3, 1, 2])).eq(3)
    expect(array.min([])).is_error()
    expect(array.max([])).is_error()
}

<test>("predicates and count") {
    expect(array.any([1, 2, 3], fun(x <int>) { x > 2 })).truthy()
    expect(array.any([1, 2, 3], fun(x <int>) { x > 9 })).falsy()
    expect(array.all([2, 4, 6], fun(x <int>) { x % 2 == 0 })).truthy()
    expect(array.all([2, 3], fun(x <int>) { x % 2 == 0 })).falsy()
    expect(array.count([1, 2, 3, 4], fun(x <int>) { x % 2 == 0 })).eq(2)
}

<test>("search") {
    expect(array.find([1, 2, 3], fun(x <int>) { x > 1 })).eq(2)
    expect(array.find([1, 2, 3], fun(x <int>) { x > 9 })).is_error()
    expect(array.find_index([1, 2, 3], fun(x <int>) { x == 2 })).eq(1)
    expect(array.find_index([1, 2, 3], fun(x <int>) { x == 9 })).eq(-1)
    expect(array.index_of([10, 20, 30], 20)).eq(1)
    expect(array.index_of([10, 20, 30], 99)).eq(-1)
}

<test>("transforms") {
    expect(array.unique([1, 1, 2, 3, 3])).eq([1, 2, 3])
    expect(array.take([1, 2, 3, 4], 2)).eq([1, 2])
    expect(array.drop([1, 2, 3, 4], 2)).eq([3, 4])
    expect(array.slice([1, 2, 3, 4, 5], 1, 4)).eq([2, 3, 4])
    expect(array.flat_map([1, 2], fun(x <int>) { [x, x] })).eq([1, 1, 2, 2])
}

<test>("chunk and sort_by") {
    expect(array.chunk([1, 2, 3, 4, 5], 2)).eq([[1, 2], [3, 4], [5]])
    expect(array.sort_by([3, 1, 2], fun(x <int>) { x })).eq([1, 2, 3])
}

<test>("group_by") {
    g <map> := array.group_by([1, 2, 3, 4], fun(x <int>) { x % 2 })
    expect(g[0]).eq([2, 4])
    expect(g[1]).eq([1, 3])
}

<test>("each_with_index") {
    seen <array>
    array.each_with_index(["a", "b"], fun(i <int>, x <str>) {
        seen = push(seen, tuple(i, x))
    })
    expect(len(seen)).eq(2)
}

// ── Searching an array of records ──
// The records below are deliberately ragged: one entry has no "person" key at
// all, which every *_where function must skip rather than error on.
fun sample_people() { [
    {"person": "john", "info": {"age": 32, "job": "unemployed"}},
    {"person": "jane"},
    {"info": {"age": 28, "job": "engineer"}},
] }

<test>("find_where returns the matching record") {
    people <array> := sample_people()
    expect(array.find_where(people, "person", "john").info.age).eq(32)
    expect(array.find_where(people, "person", "jane")).ne(None)
}

<test>("find_where returns None rather than an error on a miss") {
    expect(array.find_where(sample_people(), "person", "nobody")).eq(None)
    expect(array.find_where([], "person", "john")).eq(None)
}

<test>("find_where skips records without the key and non-maps") {
    expect(array.find_where([5, "str", None, {"id": 1}], "id", 1).id).eq(1)
    expect(array.find_where([5, "str", None], "id", 1)).eq(None)
}

<test>("find_where hands back the record itself, not a copy") {
    people <array> := sample_people()
    john := array.find_where(people, "person", "john")
    john.info.job = "developer"
    expect(people[0].info.job).eq("developer")
}

<test>("index_where reports position or -1") {
    people <array> := sample_people()
    expect(array.index_where(people, "person", "john")).eq(0)
    expect(array.index_where(people, "person", "jane")).eq(1)
    expect(array.index_where(people, "person", "zz")).eq(-1)
}

<test>("filter_where collects every match") {
    rows <array> := [{"s": "open"}, {"s": "shut"}, {"s": "open"}, {"nope": 1}]
    expect(len(array.filter_where(rows, "s", "open"))).eq(2)
    expect(array.filter_where(rows, "s", "gone")).eq([])
}

<test>("remove_where drops matches and leaves the original alone") {
    people <array> := sample_people()
    trimmed <array> := array.remove_where(people, "person", "john")
    expect(len(trimmed)).eq(2)
    expect(array.find_where(trimmed, "person", "john")).eq(None)
    expect(len(people)).eq(3)
}

<test>("where functions distinguish a stored None from a missing key") {
    // A missing key reads as None, so without the has() guard every keyless
    // record would match a search for None. Only an explicit null matches.
    // The keyless record comes first, so an unguarded index_where would
    // report 0 instead of 1.
    recs <array> := [{"other": 1}, {"person": None}]
    expect(array.index_where(recs, "person", None)).eq(1)
    expect(len(array.filter_where(recs, "person", None))).eq(1)
    expect(len(array.remove_where(recs, "person", None))).eq(1)
    expect(array.find_where([{"other": 1}], "person", None)).eq(None)
}
