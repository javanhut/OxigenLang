introduce strings

<test>("slice and char_at") {
    expect(strings.slice("hello", 1, 4)).eq("ell")
    expect(strings.char_at("hello", 0)).eq("h")
    expect(strings.is_empty("")).truthy()
    expect(strings.is_empty("x")).falsy()
}

<test>("repeat and padding") {
    expect(strings.repeated("ab", 3)).eq("ababab")
    expect(strings.pad_left("7", 3, "0")).eq("007")
    expect(strings.pad_right("7", 3, "0")).eq("700")
}

<test>("reverse and capitalize") {
    expect(strings.reverse("abc")).eq("cba")
    expect(strings.capitalize("hello")).eq("Hello")
    expect(strings.capitalize("")).eq("")
}

<test>("searching") {
    expect(strings.index_of("hello world", "world")).eq(6)
    expect(strings.index_of("hello", "z")).eq(-1)
    expect(strings.index_of("a-b-c", "-", 2)).eq(3)
    expect(strings.index_of("a-b-c", "-", 4)).eq(-1)
    expect(strings.index_of("héllo wörld", "ö", 3)).eq(7)
    expect(strings.index_of("ab", "", 2)).eq(2)
    expect(strings.index_of("ab", "x", 99)).eq(-1)
    expect(strings.count("banana", "a")).eq(3)
    expect(strings.count("aaaa", "aa")).eq(2)
}

<test>("lines") {
    expect(strings.lines("a\nb\nc")).eq(["a", "b", "c"])
}

// Byte-offset slicing used to abort the whole process on any of these: a slice
// that ends inside a multi-byte character is not a string.
<test>("searching and capitalizing non-ASCII text") {
    expect(strings.capitalize("élan")).eq("Élan")
    expect(strings.capitalize("ß")).eq("SS")
    expect(strings.index_of("héllo", "l")).eq(2)
    expect(strings.index_of("日本語です", "語")).eq(2)
    expect(strings.index_of("héllo", "z")).eq(-1)
    expect(strings.count("naïve naïve", "v")).eq(2)
    expect(strings.count("ééé", "é")).eq(3)
    expect(strings.count("abc", "")).eq(0)
}

<test>("padding counts characters, not bytes") {
    expect(strings.pad_left("é", 3, "0")).eq("00é")
    expect(strings.pad_right("é", 3, ".")).eq("é..")
    expect(strings.pad_left("7", 4, "ab")).eq("abab7")
}

<test>("padding with an empty fill is an error, not an endless loop") {
    expect(<type<Error> || <Value>>(strings.pad_left("a", 5, ""))).is_error()
    expect(<type<Error> || <Value>>(strings.pad_right("a", 5, ""))).is_error()
    expect(strings.pad_left("abc", 2, "")).eq("abc")
}

<test>("len counts characters, byte_len counts UTF-8 bytes") {
    expect(len("héllo")).eq(5)
    expect(strings.byte_len("héllo")).eq(6)
    expect(strings.byte_len("")).eq(0)
}
