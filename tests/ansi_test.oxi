introduce ansi

<test>("foreground colors wrap and reset") {
    expect(ansi.add_color("x", ansi.ForeGroundColors.Red)).eq("\e[31mx\e[0m")
    expect(ansi.add_color("x", ansi.ForeGroundColors.Green)).eq("\e[32mx\e[0m")
    expect(ansi.add_color("", ansi.ForeGroundColors.Blue)).eq("\e[34m\e[0m")
}

<test>("background colors wrap and reset") {
    expect(ansi.add_color("x", ansi.BackGroundColors.Black)).eq("\e[40mx\e[0m")
    expect(ansi.add_color("x", ansi.BackGroundColors.White)).eq("\e[47mx\e[0m")
}

<test>("modifiers wrap and reset") {
    expect(ansi.add_modifier("x", ansi.ModCodes.Bold)).eq("\e[1mx\e[0m")
    expect(ansi.add_modifier("x", ansi.ModCodes.Underline)).eq("\e[4mx\e[0m")
}

<test>("enum variants carry their escape codes") {
    expect(ansi.ModCodes.Reset.value).eq("\e[0m")
    expect(ansi.ForeGroundColors.Cyan.value).eq("\e[36m")
    expect(ansi.BackGroundColors.Magenta.value).eq("\e[45m")
}

<test>("cursor and line controls") {
    expect(ansi.clear_line()).eq("\r\e[K")
    expect(ansi.line_start()).eq("\r")
    expect(ansi.hide_cursor()).eq("\e[?25l")
    expect(ansi.show_cursor()).eq("\e[?25h")
}

<test>("coloring is composable") {
    // Nesting reinstates a reset in the middle; the outer color still opens
    // and the whole string still ends reset.
    inner := ansi.add_color("x", ansi.ForeGroundColors.Red)
    outer := ansi.add_modifier(inner, ansi.ModCodes.Bold)
    expect(outer).eq("\e[1m\e[31mx\e[0m\e[0m")
}
