fun is_ok(v <generic>) {
    option {
        is_error(v) -> {
            False
        }
        {
            True
        }
    }
}

fun is_err(v <generic>) { is_error(v) }

fun unwrap_or(v <generic>, default <generic>) {
    option {
        is_error(v) -> {
            default
        }
        {
            v
        }
    }
}

fun map_value(v <generic>, f <generic>) {
    option {
        is_error(v) -> {
            v
        }
        {
            f(v)
        }
    }
}

fun and_then(v <generic>, f <generic>) {
    option {
        is_error(v) -> {
            v
        }
        {
            f(v)
        }
    }
}

fun or_else(v <generic>, f <generic>) {
    option {
        is_error(v) -> {
            f(v)
        }
        {
            v
        }
    }
}

fun ok_or(v <generic>, msg <str>) {
    option {
        v == None -> {
            <Error<none>>(msg)
        }
        {
            v
        }
    }
}
