fun split(s <str>, delim <str>) { __split(s, delim) }

fun join(arr <array>, delim <str>) { __join(arr, delim) }

fun trim(s <str>) { __trim(s) }

fun strip(s <str>, chars <str>) { __strip(s, chars) }

fun strip_left(s <str>, chars <str>) { __strip_left(s, chars) }

fun strip_right(s <str>, chars <str>) { __strip_right(s, chars) }

fun upper(s <str>) { __upper(s) }

fun lower(s <str>) { __lower(s) }

fun replace(s <str>, old <str>, new_str <str>) { __replace(s, old, new_str) }

fun starts_with(s <str>, prefix <str>) { __starts_with(s, prefix) }

fun ends_with(s <str>, suffix <str>) { __ends_with(s, suffix) }

fun contains_str(s <str>, sub <str>) { __contains_str(s, sub) }

fun contains(s <str>, sub <str>) { __contains_str(s, sub) }

// ── Slicing & characters ──
fun slice(s <str>, start <int>, end <int>) { s[start:end] }

fun char_at(s <str>, i <int>) { str(s[i]) }

fun is_empty(s <str>) { len(s) == 0 }

// UTF-8 bytes, for wire formats; `len` counts characters.
fun byte_len(s <str>) { __byte_len(s) }

fun reverse(s <str>) {
    result <str> := ""
    each c in chars(s) {
        result = str(c) + result
    }
    result
}

// ── Building ──
// `repeat` is a reserved loop keyword, so the string repeater is `repeated`.
fun repeated(s <str>, n <int>) {
    result <str> := ""
    i <int>
    repeat when i < n {
        result = result + s
        i = i + 1
    }
    result
}

// Widths count characters: `len` counts bytes, so "é" (two bytes) used to
// count as already two wide. An empty fill can never reach the width, which
// used to loop forever.
fun pad_left(s <str>, width <int>, fill <str>) {
    result <str> := s
    have <int> := len(chars(s))
    step <int> := len(chars(fill))
    option {
        step == 0 and have < width -> {
            <fail>("pad_left: fill must not be empty")
        }
    }
    repeat when have < width {
        result = fill + result
        have = have + step
    }
    result
}

fun pad_right(s <str>, width <int>, fill <str>) {
    result <str> := s
    have <int> := len(chars(s))
    step <int> := len(chars(fill))
    option {
        step == 0 and have < width -> {
            <fail>("pad_right: fill must not be empty")
        }
    }
    repeat when have < width {
        result = result + fill
        have = have + step
    }
    result
}

// Works on characters, never byte offsets: slicing "élan" at byte 1 lands
// inside the "é".
fun capitalize(s <str>) {
    option {
        len(s) == 0 -> {
            s
        }
        {
            cs := chars(s)
            out <str> := upper(str(cs[0]))
            each c in rest(cs) {
                out = out + str(c)
            }
            out
        }
    }
}

// ── Searching ──
// Indexes count characters, matching `s[i]`.
fun index_of(s <str>, sub <str>) { __str_index_of(s, sub) }

fun count(s <str>, sub <str>) { __str_count(s, sub) }

fun lines(s <str>) { split(s, "\n") }
