enum HttpMethod {
    post: "POST"
    get: "GET"
    put: "PUT"
    patch: "PATCH"
    delete: "DELETE"
}

fun get(url <str>) { __http_request("GET", url) }

fun post(url <str>, body <str>, headers <map> = {"Content-Type": "application/json"}) { __http_request(HttpMethod.post.value, url, headers, body) }

fun put(url <str>, body <str>, headers <map> = {"Content-Type": "application/json"}) { __http_request(HttpMethod.put.value, url, headers, body) }

fun patch(url <str>, body <str>, headers <map> = {"Content-Type": "application/json"}) { __http_request(HttpMethod.patch.value, url, headers, body) }

fun delete(url <str>) { __http_request(HttpMethod.delete.value, url) }

fun head(url <str>) { __http_request("HEAD", url) }

fun request(method <HttpMethod>, url <str>, headers <generic>, body <generic>) { __http_request(method.value, url, headers, body) }

fun download(url <str>, path <str>, method <str> = "GET", headers <map> = {}, body = None) { __net_download(url, path, method, headers, body) }

fun post_to_file(url <str>, body <str>, path <str>, headers <map> = {"Content-Type": "application/json"}) { __net_download(url, path, "POST", headers, body) }

fun upload(method <str>, url <str>, file_path <str>, headers <map> = {}) { __net_upload(method, url, file_path, headers) }

fun open_stream(url <str>, method <str> = "GET", headers <map> = {}, body <str> = "") { __net_http_open(method, url, headers, body) }

fun stream_get(url <str>, headers <map> = {}) { open_stream(url, "GET", headers, "") }

fun stream_post(url <str>, body <str>, headers <map> = {"Content-Type": "application/json"}) { open_stream(url, "POST", headers, body) }

fun stream_put(url <str>, body <str>, headers <map> = {"Content-Type": "application/json"}) { open_stream(url, "PUT", headers, body) }

fun stream_patch(url <str>, body <str>, headers <map> = {"Content-Type": "application/json"}) { open_stream(url, "PATCH", headers, body) }

fun read_line(stream <int>, timeout_ms <int> = 0) { __net_http_read_line(stream, timeout_ms) }

fun read_chunk(stream <int>, max <int> = 4096, timeout_ms <int> = 0) { __net_http_read(stream, max, timeout_ms) }

fun connect(host <str>, port <int>) { __net_tcp_connect(host, port) }

fun listen(host <str>, port <int>) { __net_tcp_listen(host, port) }

fun accept(server <int>) { __net_tcp_accept(server) }

fun send(conn <int>, data <str>) { __net_send(conn, data) }

fun send_file(conn <int>, path <str>) { __net_send_file(conn, path) }

fun receive(conn <int>, max <int> = 4096) { __net_receive(conn, max) }

fun set_timeout(conn <int>, ms <int>) { __net_set_timeout(conn, ms) }

fun close(handle <int>) { __net_close(handle) }

fun udp_bind(host <str>, port <int>) { __net_udp_bind(host, port) }

fun udp_send(sock <int>, data <str>, host <str>, port <int>) { __net_udp_send(sock, data, host, port) }

fun udp_receive(sock <int>, max <int> = 4096) { __net_udp_receive(sock, max) }
