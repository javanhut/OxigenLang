introduce io
introduce path
introduce os
introduce strings

env_map <map>

fun set_env(key <generic>, value <generic>) {
    env_map[key] = value
}

// Load `filename`, or `.env` in the current directory when none is given.
// The file holds secrets, so nothing here prints it.
fun discover_dot_file(filename? <str>) {
    env_file_path <str>
    option {
        filename != None and filename != "" -> {
            env_file_path = filename when os.is_file(filename)
        }
        {
            each file in os.list_dir(os.cwd()) {
                env_file_path = file when path.filename(file) == ".env"
            }
        }
    }
    option {
        strings.is_empty(env_file_path) -> {
            <fail>("No environment file was found file.")
        }
        {
            env_file_info := io.read_file(env_file_path)
            each raw in strings.split(env_file_info, "\n") {
                line := strings.strip_right(raw, "\r")
                // Only the first `=` separates: values such as base64 keys and
                // URLs with query strings contain more.
                parts := strings.split(line, "=")
                k := strings.trim(parts[0])
                v := strings.join(rest(parts), "=")
                option {
                    len(parts) > 1 and k != "" and not strings.starts_with(k, "#") and v != "" -> {
                        set_env(k, v)
                    }
                }
            }
        }
    }
}

fun get_env(key <str>) {
    option {
        has(env_map, key) -> {
            env_map[key]
        }
        {
            println("Key: {key} not found in env_map")
            None
        }
    }
}
