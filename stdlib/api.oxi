introduce net
introduce path
introduce io

head_limit <int> = 65536
body_limit <int> = 8388608
read_size <int> = 65536
accept_retry_limit <int> = 100
keep_alive_max <int> = 100

struct Res {
    status <int>
    headers <map>
    body <str>
}

struct FileRes {
    status <int>
    headers <map>
    path <str>
    size <int>
}

struct App {
    server <int>
    routes <map>
    dynamic <array>
    keep_alive <bool>
    idle_timeout <int>
    header_timeout <int>
    body_timeout <int>
}

default_header_timeout <int> = 10000
default_body_timeout <int> = 60000

fun setting(cfg <map>, key <str>, fallback <generic>) {
    v := cfg[key]
    give fallback when v == None
    v
}

fun app(cfg <map>) { App(cfg["server"], {}, [], cfg["keep_alive"], cfg["idle_timeout"], setting(cfg, "header_timeout", default_header_timeout), setting(cfg, "body_timeout", default_body_timeout)) }

fun json(data <generic>, status <int> = 200) { Res(status, {"Content-Type": "application/json"}, __json_stringify(data)) }

fun text(body <str>, status <int> = 200) { Res(status, {"Content-Type": "text/plain; charset=utf-8"}, body) }

fun html(body <str>, status <int> = 200) { Res(status, {"Content-Type": "text/html; charset=utf-8"}, body) }

fun redirect(location <str>, status <int> = 302) { Res(status, {"Location": location}, "") }

fun respond(status <int>, body <str>, headers <map> = {}) { Res(status, headers, body) }

fun fail_with(status <int>, message <str>) { json({"error": message}, status) }

fun content_type(p <str>) {
    e <str> := __lower(path.ext(p))
    types <map> := {"html": "text/html; charset=utf-8", "htm": "text/html; charset=utf-8", "css": "text/css; charset=utf-8", "js": "text/javascript; charset=utf-8", "mjs": "text/javascript; charset=utf-8", "json": "application/json", "svg": "image/svg+xml", "png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg", "gif": "image/gif", "webp": "image/webp", "ico": "image/x-icon", "woff2": "font/woff2", "woff": "font/woff", "txt": "text/plain; charset=utf-8", "xml": "application/xml", "pdf": "application/pdf"}
    found <generic> := types[e]
    give found unless found == None
    "application/octet-stream"
}

fun file(p <str>, status <int> = 200) {
    give fail_with(404, "not found") unless __is_file(p)
    size := __file_size(p)
    give fail_with(404, "not found") when is_error(size)
    FileRes(status, {"Content-Type": content_type(p)}, p, size)
}

fun static_dir(req <map>, root <str>) {
    rel <str> := req["path"]
    rel = rel + "index.html" when __ends_with(rel, "/")
    rel = __strip_left(rel, "/")
    target <str> := path.normalize(path.join([root, rel]))
    give fail_with(404, "not found") unless path.is_within(root, target)
    file(target)
}

fun body_json(req <map>) { __json_parse(req["body"]) }

fun form(req <map>) { parse_query(req["body"]) }

fun decode(s <str>) {
    decoded := __url_decode(s)
    option {
        is_error(decoded) -> {
            s
        }
        {
            decoded
        }
    }
}

fun parse_query(s <str>) {
    out <map> := {}
    each pair in __split(s, "&") {
        option {
            pair != "" -> {
                kv := __split(pair, "=")
                out[decode(kv[0])] = option {
                    len(kv) > 1 -> {
                        decode(__join(rest(kv), "="))
                    }
                    {
                        ""
                    }
                }
            }
        }
    }
    out
}

fun compile_path(path <str>) {
    out <array> := []
    each seg in __split(path, "/") {
        out = push(out, (__starts_with(seg, ":"), __strip(seg, ":")))
    }
    out
}

App includes {
    fun route(method <str>, path <str>, handler <generic>) {
        option {
            __contains_str(path, "/:") or __ends_with(path, "/*") -> {
                self.dynamic = push(self.dynamic, (method, compile_path(path), handler))
            }
            {
                self.routes[method + " " + path] = handler
            }
        }
        self
    }

    fun get(path <str>, handler <generic>) { self.route("GET", path, handler) }

    fun post(path <str>, handler <generic>) { self.route("POST", path, handler) }

    fun put(path <str>, handler <generic>) { self.route("PUT", path, handler) }

    fun patch(path <str>, handler <generic>) { self.route("PATCH", path, handler) }

    fun delete(path <str>, handler <generic>) { self.route("DELETE", path, handler) }

    fun listen() {
        failures <int> := 0
        repeat when failures < accept_retry_limit {
            conn := <type<Error> || <Value>>(net.accept(self.server))
            option {
                is_error(conn) -> {
                    failures = failures + 1
                    <log<Error>>("api: accept failed: {conn.msg}")
                }
                {
                    failures = 0
                    net.set_timeout(conn.value, self.idle_timeout)
                    outcome := <type<Error> || <Value>>(self.serve_conn(conn.value))
                    <log<Error>>("api: connection dropped: {outcome.msg}") when is_error(outcome)
                    net.close(conn.value)
                }
            }
        }
        <log<Error>>("api: giving up after {accept_retry_limit} consecutive accept failures")
    }

    fun serve_conn(conn <int>) {
        live <bool> := True
        served <int> := 0
        repeat when live {
            req := read_request(conn, self.header_timeout, self.body_timeout)
            option {
                req == None -> {
                    live = False
                }
                type(req) == "Res" -> {
                    net.send(conn, render(req, False))
                    live = False
                }
                {
                    served = served + 1
                    live = self.keep_alive and served < keep_alive_max and wants_keep_alive(req)
                    send_res(conn, self.dispatch(req), live)
                }
            }
        }
    }

    fun dispatch(req <map>) {
        key := req["method"] + " " + req["path"]
        handler, params := option {
            has(self.routes, key) -> {
                (self.routes[key], {})
            }
            {
                match_dynamic(self.dynamic, req["method"], __split(req["path"], "/"))
            }
        }
        option {
            handler == None -> {
                miss(self.routes, self.dynamic, req["path"])
            }
            {
                req["params"] = params
                outcome := <type<Error> || <Value>>(handler(req))
                option {
                    is_error(outcome) -> {
                        <log<Error>>("api: {req["method"]} {req["path"]} failed: {outcome.msg}")
                        fail_with(500, "internal server error")
                    }
                    {
                        to_res(outcome.value)
                    }
                }
            }
        }
    }
}

fun match_segments(segments <array>, segs <array>) {
    count := len(segs)
    fixed := len(segments)
    last_param, last_name := segments[fixed - 1]
    wild := not last_param and last_name == "*"
    fixed = fixed - 1 when wild
    option {
        wild and count < fixed -> {
            give None
        }
        not wild and count != fixed -> {
            give None
        }
    }
    params <map> := {}
    option {
        wild -> {
            tail <array> := []
            each i in range(fixed, count) {
                tail = push(tail, segs[i])
            }
            params["*"] = decode(__join(tail, "/"))
        }
    }
    each i in range(fixed) {
        is_param, name := segments[i]
        option {
            is_param -> {
                params[name] = decode(segs[i])
            }
            name != segs[i] -> {
                give None
            }
        }
    }
    params
}

fun match_dynamic(dynamic <array>, method <str>, segs <array>) {
    each entry in dynamic {
        route_method, segments, handler := entry
        option {
            route_method == method -> {
                params := match_segments(segments, segs)
                give (handler, params) when params != None
            }
        }
    }
    (None, {})
}

fun allowed_methods(routes <map>, dynamic <array>, path <str>) {
    segs := __split(path, "/")
    out <array> := []
    each key in keys(routes) {
        parts := __split(key, " ")
        out = push(out, parts[0]) when __join(rest(parts), " ") == path
    }
    each entry in dynamic {
        route_method, segments, handler := entry
        out = push(out, route_method) when match_segments(segments, segs) != None
    }
    out
}

fun miss(routes <map>, dynamic <array>, path <str>) {
    allowed := allowed_methods(routes, dynamic, path)
    option {
        len(allowed) == 0 -> {
            fail_with(404, "not found")
        }
        {
            Res(405, {"Content-Type": "application/json", "Allow": __join(allowed, ", ")}, __json_stringify({"error": "method not allowed", "allow": allowed}))
        }
    }
}

fun to_res(v <generic>) {
    option {
        type(v) == "Res" or type(v) == "FileRes" -> {
            v
        }
        type(v) == "STRING" -> {
            text(v)
        }
        {
            json(v)
        }
    }
}

fun elapsed_ms(started <int>) { (__time_monotonic() - started) / 1000000 }

fun read_request(conn <int>, header_ms <int> = default_header_timeout, body_ms <int> = default_body_timeout) {
    started <int> := __time_monotonic()
    buf <str> := net.receive(conn, read_size)
    repeat when buf != "" and not __contains_str(buf, "\r\n\r\n") and __byte_len(buf) <= head_limit {
        option {
            elapsed_ms(started) > header_ms -> {
                give fail_with(408, "request header timeout")
            }
        }
        chunk := net.receive(conn, read_size)
        option {
            chunk == "" -> {
                stop
            }
        }
        buf = buf + chunk
    }
    option {
        buf == "" -> {
            give None
        }
        not __contains_str(buf, "\r\n\r\n") -> {
            give fail_with(431, "request headers too large")
        }
    }
    parts := __split(buf, "\r\n\r\n")
    lines := __split(parts[0], "\r\n")
    request_line := __split(lines[0], " ")
    option {
        len(request_line) < 3 -> {
            give fail_with(400, "malformed request line")
        }
    }
    headers <map> := {}
    each line in rest(lines) {
        kv := __split(line, ":")
        headers[__lower(__trim(kv[0]))] = __trim(__join(rest(kv), ":")) when len(kv) > 1
    }
    option {
        has(headers, "transfer-encoding") -> {
            give fail_with(501, "Transfer-Encoding is not supported; send a Content-Length")
        }
    }
    length := content_length(headers)
    option {
        is_error(length) -> {
            give fail_with(400, "invalid Content-Length")
        }
        length.value > body_limit -> {
            give fail_with(413, "request body too large")
        }
    }
    body := read_body(conn, __join(rest(parts), "\r\n\r\n"), length.value, body_ms)
    give body when type(body) == "Res"
    target := request_line[1]
    path <str> := target
    query <map> := {}
    option {
        __contains_str(target, "?") -> {
            split_target := __split(target, "?")
            path = split_target[0]
            query = parse_query(__join(rest(split_target), "?"))
        }
    }
    {"method": request_line[0], "version": request_line[2], "path": path, "params": {}, "query": query, "headers": headers, "body": body}
}

fun content_length(headers <map>) {
    option {
        has(headers, "content-length") -> {
            raw := __trim(headers["content-length"])
            give <Error>("invalid Content-Length") unless __regex_match("^[0-9]+$", raw)
            <type<Error> || <Value>>(int(raw))
        }
        {
            <Value>(0)
        }
    }
}

fun read_body(conn <int>, so_far <str>, length <int>, body_ms <int> = default_body_timeout) {
    have <int> := __byte_len(so_far)
    option {
        have >= length -> {
            give so_far
        }
    }
    started <int> := __time_monotonic()
    chunks <array> := [so_far]
    repeat when have < length {
        option {
            elapsed_ms(started) > body_ms -> {
                give fail_with(408, "request body timeout")
            }
        }
        chunk := net.receive(conn, read_size)
        option {
            chunk == "" -> {
                give fail_with(400, "request body shorter than its Content-Length")
            }
        }
        chunks = push(chunks, chunk)
        have = have + __byte_len(chunk)
    }
    __join(chunks, "")
}

fun wants_keep_alive(req <map>) {
    connection := option {
        has(req["headers"], "connection") -> {
            __lower(req["headers"]["connection"])
        }
        {
            ""
        }
    }
    option {
        connection == "close" -> {
            False
        }
        connection == "keep-alive" -> {
            True
        }
        {
            req["version"] == "HTTP/1.1"
        }
    }
}

fun header_safe(text <generic>) { __replace(__replace(__replace("{text}", "\r", " "), "\n", " "), "\0", " ") }

fun render_head(status <int>, headers <map>, length <int>, live <bool>) {
    out <array> := ["HTTP/1.1 {status} {reason(status)}\r\n"]
    each name, value in headers {
        out = push(out, "{header_safe(name)}: {header_safe(value)}\r\n")
    }
    out = push(out, "Content-Length: {length}\r\n")
    out = push(out, option {
        live -> {
            "Connection: keep-alive\r\n"
        }
        {
            "Connection: close\r\n"
        }
    })
    out = push(out, "\r\n")
    __join(out, "")
}

fun render(res <Res>, live <bool>) { render_head(res.status, res.headers, __byte_len(res.body), live) + res.body }

fun send_res(conn <int>, res <generic>, live <bool>) {
    option {
        type(res) == "FileRes" -> {
            net.send(conn, render_head(res.status, res.headers, res.size, live))
            __net_send_file(conn, res.path)
        }
        {
            net.send(conn, render(res, live))
        }
    }
}

fun reason(status <int>) {
    option {
        status == 200 -> {
            "OK"
        }
        status == 201 -> {
            "Created"
        }
        status == 202 -> {
            "Accepted"
        }
        status == 204 -> {
            "No Content"
        }
        status == 301 -> {
            "Moved Permanently"
        }
        status == 302 -> {
            "Found"
        }
        status == 304 -> {
            "Not Modified"
        }
        status == 400 -> {
            "Bad Request"
        }
        status == 401 -> {
            "Unauthorized"
        }
        status == 403 -> {
            "Forbidden"
        }
        status == 404 -> {
            "Not Found"
        }
        status == 405 -> {
            "Method Not Allowed"
        }
        status == 408 -> {
            "Request Timeout"
        }
        status == 409 -> {
            "Conflict"
        }
        status == 413 -> {
            "Content Too Large"
        }
        status == 422 -> {
            "Unprocessable Content"
        }
        status == 429 -> {
            "Too Many Requests"
        }
        status == 431 -> {
            "Request Header Fields Too Large"
        }
        status == 500 -> {
            "Internal Server Error"
        }
        status == 501 -> {
            "Not Implemented"
        }
        status == 503 -> {
            "Service Unavailable"
        }
        {
            "OK"
        }
    }
}

fun serve(worker <generic>, host <str> = "127.0.0.1", port <int> = 8000, workers <int> = 64, keep_alive <bool> = True, idle_timeout <int> = 5000, header_timeout <int> = 10000, body_timeout <int> = 60000) {
    server := net.listen(host, port)
    println("api listening on http://{host}:{port} ({workers} workers)")
    config := {"server": server, "keep_alive": keep_alive, "idle_timeout": idle_timeout, "header_timeout": header_timeout, "body_timeout": body_timeout}
    tasks <array> := []
    each i in range(workers) {
        tasks = push(tasks, __spawn(worker, config))
    }
    converge tasks
}
